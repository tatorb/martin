# Variables del endpoint /api/reserva. Los valores reales se cargan en el
# panel de Vercel, nunca en el repositorio.

# Secreto compartido con el Google Apps Script. Viaja en la cabecera
# x-reserva-secret de cada petición.
RESERVA_WEBHOOK_SECRET=

# Conjunto de datos de Meta (el mismo identificador del píxel).
META_DATASET_ID=

# Token de acceso de la API de conversiones, generado en el Administrador
# de eventos de Meta.
META_ACCESS_TOKEN=

# Opcional. Sólo si alguna vez hay que cambiar la versión de la API.
# Por defecto v21.0.
META_API_VERSION=

# --- Formulario de lead magnets (/lm/...) ---

# Clave de la API de Resend, el servicio que manda el mail con los datos
# del interesado. Sin esto el formulario sigue funcionando y la descarga se
# habilita, pero el aviso por mail no sale: el dato queda sólo en los
# registros de Vercel.
RESEND_API_KEY=

# Opcional. A dónde llega el aviso. Por defecto martin@studiomrb.com.
LEAD_EMAIL_TO=

# Opcional. Desde qué dirección sale. Tiene que ser un dominio verificado
# en Resend, por ejemplo "Studio MRB <landing@studiomrb.com>".
LEAD_EMAIL_FROM=
