---
/**
 * Página de un lead magnet: /lm/[slug]
 *
 * Se genera una por cada entrada de src/leadmagnets.ts. Muestra de qué se
 * trata el material y pide los datos. Recién cuando el envío sale bien
 * aparece el botón de descarga.
 */
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AgendaModal from '../../components/AgendaModal.astro';
import { BLOCK_H, PAGE_INSET, PAGE_RADIUS } from '../../components/HeaderShape.astro';
import { LEAD_MAGNETS } from '../../leadmagnets';

export function getStaticPaths() {
  return LEAD_MAGNETS.map((magnet) => ({
    params: { slug: magnet.slug },
    props: { magnet },
  }));
}

const { magnet } = Astro.props;

const campos = [
  { id: 'nombre', etiqueta: 'Nombre y apellido', tipo: 'text', ejemplo: 'Juan Pérez', auto: 'name' },
  { id: 'empresa', etiqueta: 'Sitio web de tu empresa', tipo: 'text', ejemplo: 'studiomrb.com', auto: 'url' },
  { id: 'email', etiqueta: 'Email de trabajo', tipo: 'email', ejemplo: 'juan@empresa.com', auto: 'email' },
  { id: 'telefono', etiqueta: 'Teléfono', tipo: 'tel', ejemplo: '+54 9 351 123 4567', auto: 'tel' },
] as const;
---

<Base title={magnet.seo.titulo} description={magnet.seo.descripcion}>
  <Header ctaHref="/#agenda" homeHref="/" />

  <main style={`padding:0 ${PAGE_INSET}px`}>
    <section
      class="relative isolate overflow-hidden text-paper"
      style={`border-radius:${PAGE_RADIUS}px`}
    >
      <div aria-hidden="true" class="aurora pointer-events-none absolute inset-0"></div>

      <div
        class="relative mx-auto grid max-w-6xl gap-12 px-6 pb-20 md:pb-28 lg:grid-cols-[1fr_420px] lg:gap-16"
        style={`padding-top:${BLOCK_H + 64}px`}
      >
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.14em] text-line">Material gratuito</p>

          <h1 class="mt-6 text-3xl font-normal leading-[1.1] tracking-tight sm:text-4xl md:text-5xl">
            {magnet.titulo}
          </h1>

          <p class="mt-5 text-lg text-line md:text-xl">{magnet.bajada}</p>

          <p class="mt-8 max-w-2xl leading-relaxed text-line">{magnet.descripcion}</p>

          <ul class="mt-10 grid gap-3">
            {
              magnet.puntos.map((punto) => (
                <li class="flex gap-3 rounded-[10px] border border-white/15 bg-white/5 p-5 text-sm leading-relaxed backdrop-blur-sm">
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    class="mt-[3px] shrink-0"
                  >
                    <path d="M4 12.5l5 5L20 6.5" />
                  </svg>
                  <span>{punto}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="lg:pt-2">
          <div
            class="bg-paper p-7 text-ink md:p-8"
            style={`border-radius:${PAGE_RADIUS}px`}
            data-tarjeta
          >
            <div data-paso="formulario">
              <h2 class="text-xl font-normal tracking-tight">Completá para descargarlo</h2>
              <p class="mt-3 text-sm leading-relaxed text-muted">
                Te lo damos ahora mismo, en esta misma pantalla.
              </p>

              <form class="mt-7 grid gap-5" novalidate data-formulario data-slug={magnet.slug}>
                {
                  campos.map((campo) => (
                    <div>
                      <label
                        for={campo.id}
                        class="block text-sm font-medium text-ink"
                      >
                        {campo.etiqueta}
                      </label>
                      <input
                        id={campo.id}
                        name={campo.id}
                        type={campo.tipo}
                        autocomplete={campo.auto}
                        placeholder={campo.ejemplo}
                        aria-describedby={`error-${campo.id}`}
                        class="mt-2 w-full rounded-md border border-line bg-mist px-4 py-3 text-base text-ink outline-none transition-colors placeholder:text-muted/60 focus:border-ink"
                      />
                      <p
                        id={`error-${campo.id}`}
                        class="mt-1.5 hidden text-sm text-[#b42318]"
                        data-error={campo.id}
                        role="alert"
                      />
                    </div>
                  ))
                }

                {/* Trampa para robots. Invisible y fuera del recorrido del teclado. */}
                <div class="absolute left-[-9999px]" aria-hidden="true">
                  <label for="sitio">No completar</label>
                  <input id="sitio" name="sitio" type="text" tabindex="-1" autocomplete="off" />
                </div>

                <button
                  type="submit"
                  class="mt-1 inline-flex items-center justify-center gap-2.5 rounded-md bg-ink px-8 py-3.5 text-base font-medium text-paper shadow-[0_0_13px_-2px_rgba(0,0,0,0.51)] transition-colors duration-200 hover:bg-accent disabled:cursor-not-allowed disabled:opacity-60"
                  data-enviar
                >
                  Quiero el material
                </button>

                <p class="hidden text-sm text-[#b42318]" data-error-general role="alert"></p>

                <p class="text-xs leading-relaxed text-muted">
                  Usamos tus datos para enviarte el material y, como mucho, escribirte una vez. No
                  compartimos nada con terceros.
                </p>
              </form>
            </div>

            <div class="hidden" data-paso="listo">
              <div
                class="flex h-12 w-12 items-center justify-center rounded-full bg-mist text-ink"
                aria-hidden="true"
              >
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M4 12.5l5 5L20 6.5" />
                </svg>
              </div>

              <h2 class="mt-5 text-xl font-normal tracking-tight">Listo, ya es tuyo</h2>
              <p class="mt-3 text-sm leading-relaxed text-muted">
                Tocá el botón y se descarga el PDF. Si querés, después charlamos 30 minutos sobre
                cómo aplicarlo en tu operación.
              </p>

              <a
                href={magnet.archivo}
                download={magnet.nombreDescarga}
                class="mt-7 inline-flex w-full items-center justify-center gap-2.5 rounded-md bg-ink px-8 py-3.5 text-base font-medium text-paper shadow-[0_0_13px_-2px_rgba(0,0,0,0.51)] transition-colors duration-200 hover:bg-accent"
                data-descarga
              >
                {magnet.etiquetaDescarga}
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path
                    d="M12 4v11m0 0l-4.5-4.5M12 15l4.5-4.5M4.5 19.5h15"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </a>

              <a
                href="/#agenda"
                data-lead="boton_lead_magnet"
                class="mt-3 inline-flex w-full items-center justify-center gap-2.5 rounded-md border border-ink px-8 py-3.5 text-base font-medium text-ink transition-colors duration-200 hover:bg-ink hover:text-paper"
              >
                Agendar una reunión
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <AgendaModal />
</Base>

<style>
  /* Mismo fondo que el hero de la home, sin las manchas animadas: acá el
     protagonista es el formulario. */
  .aurora {
    background: linear-gradient(150deg, #3b4349 0%, #20262a 46%, #0e1113 100%);
  }
</style>

<script>
  import { limpiarDatos, validarLead, type DatosLead } from '../../lib/validacion';

  const formulario = document.querySelector<HTMLFormElement>('[data-formulario]');
  const tarjeta = document.querySelector<HTMLElement>('[data-tarjeta]');
  const pasoFormulario = tarjeta?.querySelector<HTMLElement>('[data-paso="formulario"]');
  const pasoListo = tarjeta?.querySelector<HTMLElement>('[data-paso="listo"]');
  const boton = formulario?.querySelector<HTMLButtonElement>('[data-enviar]');
  const errorGeneral = formulario?.querySelector<HTMLElement>('[data-error-general]');

  const CAMPOS = ['nombre', 'empresa', 'email', 'telefono'] as const;

  function campo(nombre: string): HTMLInputElement | null {
    return formulario?.querySelector<HTMLInputElement>(`#${nombre}`) ?? null;
  }

  function mostrarError(nombre: string, mensaje: string | null) {
    const caja = formulario?.querySelector<HTMLElement>(`[data-error="${nombre}"]`);
    const entrada = campo(nombre);
    if (caja) {
      caja.textContent = mensaje ?? '';
      caja.classList.toggle('hidden', !mensaje);
    }
    if (entrada) {
      entrada.classList.toggle('border-[#b42318]', Boolean(mensaje));
      entrada.setAttribute('aria-invalid', mensaje ? 'true' : 'false');
    }
  }

  function leerDatos(): DatosLead {
    return limpiarDatos({
      nombre: campo('nombre')?.value,
      empresa: campo('empresa')?.value,
      email: campo('email')?.value,
      telefono: campo('telefono')?.value,
    });
  }

  // Validación al salir de cada campo. Antes de eso no se molesta a nadie,
  // que es lo que hace que un formulario se sienta amable.
  for (const nombre of CAMPOS) {
    const entrada = campo(nombre);
    entrada?.addEventListener('blur', () => {
      if (!entrada.value.trim()) return; // vacío y sin tocar: todavía no es un error
      mostrarError(nombre, validarLead(leerDatos())[nombre] ?? null);
    });
    // Si ya había un error, se limpia apenas la persona corrige.
    entrada?.addEventListener('input', () => {
      if (entrada.getAttribute('aria-invalid') === 'true') {
        mostrarError(nombre, validarLead(leerDatos())[nombre] ?? null);
      }
    });
  }

  formulario?.addEventListener('submit', async (evento) => {
    evento.preventDefault();
    if (!formulario || !boton) return;

    const datos = leerDatos();
    const errores = validarLead(datos);

    for (const nombre of CAMPOS) mostrarError(nombre, errores[nombre] ?? null);

    if (Object.keys(errores).length > 0) {
      campo(Object.keys(errores)[0])?.focus();
      return;
    }

    if (errorGeneral) errorGeneral.classList.add('hidden');
    boton.disabled = true;
    const etiqueta = boton.textContent;
    boton.textContent = 'Enviando...';

    try {
      const respuesta = await fetch('/api/lead', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          ...datos,
          slug: formulario.dataset.slug,
          sitio: formulario.querySelector<HTMLInputElement>('#sitio')?.value ?? '',
        }),
      });

      const resultado = await respuesta.json().catch(() => ({}) as any);

      if (!respuesta.ok) {
        // El servidor revalida. Si algo no le gustó, se muestra en su campo.
        if (resultado?.errores) {
          for (const nombre of CAMPOS) mostrarError(nombre, resultado.errores[nombre] ?? null);
        } else if (errorGeneral) {
          errorGeneral.textContent = 'No pudimos enviarlo. Probá de nuevo en un momento.';
          errorGeneral.classList.remove('hidden');
        }
        return;
      }

      // Evento de conversión del píxel. No se espera respuesta.
      const fbq = (window as any).fbq;
      if (typeof fbq === 'function') {
        try {
          fbq('track', 'Lead', { content_name: `lm_${formulario.dataset.slug}` });
        } catch {
          /* el píxel no puede romper la descarga */
        }
      }

      pasoFormulario?.classList.add('hidden');
      pasoListo?.classList.remove('hidden');
      pasoListo?.querySelector<HTMLAnchorElement>('[data-descarga]')?.focus();
    } catch {
      if (errorGeneral) {
        errorGeneral.textContent = 'No hay conexión. Revisá tu internet y probá de nuevo.';
        errorGeneral.classList.remove('hidden');
      }
    } finally {
      boton.disabled = false;
      if (etiqueta) boton.textContent = etiqueta;
    }
  });
</script>
