---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Vsl from '../components/Vsl.astro';
import Casos from '../components/Casos.astro';
import Fundador from '../components/Fundador.astro';
import Sistema from '../components/Sistema.astro';
import Agenda from '../components/Agenda.astro';
import Faqs from '../components/Faqs.astro';
import Footer from '../components/Footer.astro';
---

{/* El header se posiciona absoluto sobre el hero, por eso el envoltorio es relativo. */}
<Base>
  <div class="relative">
    <Header />
  </div>
  <main>
    <Hero />
    <Vsl />
    <Casos />
    <Fundador />
    <Sistema />
    <Agenda />
    <Faqs />
  </main>
  <Footer />
</Base>
