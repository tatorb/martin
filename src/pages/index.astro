---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { PAGE_INSET } from '../components/HeaderShape.astro';
import Hero from '../components/Hero.astro';
import Vsl from '../components/Vsl.astro';
import Casos from '../components/Casos.astro';
import Sistema from '../components/Sistema.astro';
import Agenda from '../components/Agenda.astro';
import Faqs from '../components/Faqs.astro';
import Footer from '../components/Footer.astro';
import AgendaModal from '../components/AgendaModal.astro';
---

<Base>
  {/* El header con la silueta SVG salió de acá. Sigue vivo y se puede ver en
      /header-anterior, para no perder el trabajo de su geometría. */}
  <div class="flex justify-center py-8" style={`padding-left:${PAGE_INSET}px;padding-right:${PAGE_INSET}px`}>
    <Logo class="h-6" />
  </div>

  <main>
    <Hero />
    <Vsl />
    <Casos />
    <Sistema />
    <Agenda />
    <Faqs />
  </main>
  <Footer />
  <AgendaModal />
</Base>
