---
/**
 * Columna de textos de un lead magnet: el título, la bajada, la descripción y
 * la lista de qué se lleva quien lo descarga.
 *
 * Lo usan las dos páginas del material, la que pide los datos y la de descarga
 * directa, así que vive acá y no duplicado en cada una.
 */
import type { LeadMagnet } from '../leadmagnets';

interface Props {
  magnet: LeadMagnet;
}

const { magnet } = Astro.props;
---

<div>
  <p class="text-sm font-semibold uppercase tracking-[0.14em] text-line">Material gratuito</p>

  <h1 class="mt-6 text-3xl font-normal leading-[1.1] tracking-tight sm:text-4xl md:text-5xl">
    {magnet.titulo}
  </h1>

  {magnet.bajada && <p class="mt-5 text-lg text-line md:text-xl">{magnet.bajada}</p>}

  {magnet.descripcion && (
    <p class="mt-8 max-w-2xl leading-relaxed text-line">{magnet.descripcion}</p>
  )}

  <ul class="mt-10 grid gap-3">
    {
      (magnet.puntos ?? []).map((punto) => (
        <li class="flex gap-3 rounded-[10px] border border-white/15 bg-white/5 p-5 text-sm leading-relaxed backdrop-blur-sm">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="mt-[3px] shrink-0"
          >
            <path d="M4 12.5l5 5L20 6.5" />
          </svg>
          <span>{punto}</span>
        </li>
      ))
    }
  </ul>
</div>
