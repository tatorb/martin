---
import { PAGE_INSET, PAGE_RADIUS } from './HeaderShape.astro';
import { VSL_VERTICAL_EMBED_URL } from '../site.config';
import { urlDeEmbed } from '../lib/video';
import Reproductor from './Reproductor.astro';

// Sin autoplay: el de arriba ya arranca solo y dos a la vez es demasiado.
const vertical = urlDeEmbed(VSL_VERTICAL_EMBED_URL, { autoplay: false });
// Portfolio real, tomado de la presentación institucional y de la propuesta de
// trabajo. Solo la cuenta y el tipo de empresa que es.
const casos = [
  { cuenta: 'Building Networks', tipo: 'Servicios IT' },
  { cuenta: 'ERKS', tipo: 'Tecnologías inmersivas' },
  { cuenta: 'Innova House', tipo: 'Desarrolladora inmobiliaria' },
  { cuenta: 'Financers', tipo: 'Fintech' },
];
---

<section id="casos" style={`padding:0 ${PAGE_INSET}px`}>
  <div class="bg-paper" style={`border-radius:${PAGE_RADIUS}px`}>
  <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
    <div class="max-w-3xl">
      <h2 class="text-3xl font-normal leading-tight tracking-tight md:text-4xl">
        Cuentas que hoy prospectan con un sistema
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-muted">
        Cada una arrancó en un punto distinto. En todas el trabajo fue el mismo, ordenar el
        acercamiento inicial y sostenerlo en el tiempo.
      </p>
    </div>

    {
      vertical && (
        // Vertical y angosto a propósito: es un apoyo, no tiene que comerse la
        // pantalla. El ancho fijo es lo que le pone el techo al alto.
        <div class="mt-12 w-[240px] overflow-hidden rounded-[10px] bg-ink md:w-[260px]">
          <iframe
            src={vertical}
            data-yt
            title="Cuentas que prospectan con un sistema"
            class="block aspect-[9/16] w-full"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture"
            allowfullscreen
          />
        </div>
      )
    }

    <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        casos.map((c) => (
          <article class="rounded-[10px] border border-line bg-mist p-7">
            <h3 class="text-xl font-normal tracking-tight">{c.cuenta}</h3>
            <p class="mt-2 text-base leading-relaxed text-muted">{c.tipo}</p>
          </article>
        ))
      }
    </div>
  </div>
  </div>
</section>

<Reproductor />
