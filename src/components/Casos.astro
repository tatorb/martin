---
import { PAGE_INSET, PAGE_RADIUS } from './HeaderShape.astro';
import { VSL_VERTICALES } from '../site.config';
import { urlDeEmbed } from '../lib/video';
import Reproductor from './Reproductor.astro';

// Sin autoplay: el VSL de arriba ya arranca solo y varios a la vez es demasiado.
const verticales = VSL_VERTICALES.filter(Boolean).map((url) => urlDeEmbed(url, { autoplay: false }));
---

<section id="casos" style={`padding:0 ${PAGE_INSET}px`}>
  <div class="bg-paper" style={`border-radius:${PAGE_RADIUS}px`}>
  <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
    <div class="max-w-3xl">
      <h2 class="text-3xl font-normal leading-tight tracking-tight md:text-4xl">
        Cuentas que hoy prospectan con un sistema
      </h2>
    </div>

    {
      verticales.length > 0 && (
        // Uno al lado del otro en todos los tamaños, también en celular. El
        // ancho máximo del conjunto es lo que les pone techo al alto: son un
        // apoyo y no tienen que comerse la pantalla.
        <div class="mt-12 grid max-w-[540px] grid-cols-2 gap-3 sm:gap-4">
          {verticales.map((src, i) => (
            <div class="overflow-hidden rounded-[10px] bg-ink">
              <iframe
                src={src}
                data-yt
                title={`Testimonio ${i + 1}`}
                class="block aspect-[9/16] w-full"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture"
                allowfullscreen
              />
            </div>
          ))}
        </div>
      )
    }
  </div>
  </div>
</section>

<Reproductor />
