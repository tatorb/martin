---
// Portfolio real, tomado de la presentación institucional y de la propuesta de
// trabajo. Solo la cuenta y el tipo de empresa que es.
const casos = [
  { cuenta: 'Building Networks', tipo: 'Servicios IT' },
  { cuenta: 'ERKS', tipo: 'Tecnologías inmersivas' },
  { cuenta: 'Innova House', tipo: 'Desarrolladora inmobiliaria' },
  { cuenta: 'Financers', tipo: 'Fintech' },
];
---

<section id="casos" class="border-b border-line/70">
  <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
    <div class="max-w-3xl">
      <h2 class="text-3xl font-normal leading-tight tracking-tight md:text-4xl">
        Cuentas que hoy prospectan con un sistema
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-muted">
        Cada una arrancó en un punto distinto. En todas el trabajo fue el mismo, ordenar el
        acercamiento inicial y sostenerlo en el tiempo.
      </p>
    </div>

    <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        casos.map((c) => (
          <article class="rounded-[10px] border border-line bg-mist p-7">
            <h3 class="text-xl font-normal tracking-tight">{c.cuenta}</h3>
            <p class="mt-2 text-base leading-relaxed text-muted">{c.tipo}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
