---
// Portfolio real, tomado de la presentación institucional y de la propuesta de trabajo.
// Sin cifras, porque no hay resultados publicables verificados.
const casos = [
  {
    cuenta: 'Building Networks',
    industria: 'Servicios IT',
    periodo: '2024 a hoy',
    resumen:
      'Consultoría, diseño, producción y ejecución de la estrategia comercial completa, con el control centralizado en HubSpot.',
    trabajo: [
      'Definición del posicionamiento de la empresa',
      'Sitio web, perfiles digitales y material comercial interrelacionados',
      'Diseño y ejecución de la prospección por mail y LinkedIn',
    ],
  },
  {
    cuenta: 'ERKS',
    industria: 'Tecnologías inmersivas',
    periodo: '2022 a 2025',
    resumen:
      'Estrategia comercial integral durante 2024, con producción de todas las piezas necesarias para aplicarla.',
    trabajo: [
      'Asesoría comercial en estrategias digitales',
      'Project management de la producción de materiales',
      'Account management con BBDO Colombia, Unilever Argentina, SONY Colombia, Tag Heuer España y ProColombia',
    ],
  },
  {
    cuenta: 'Innova House',
    industria: 'Desarrolladora inmobiliaria',
    periodo: '2024 a hoy',
    resumen:
      'Consultoría, diseño, producción y ejecución de la estrategia comercial, con campaña de prospección en frío en marcha.',
    trabajo: [
      'Definición de la empresa y de su primera estrategia',
      'Producción del sitio, los perfiles y el material comercial sobre HubSpot',
      'Campaña de prospección por mail y LinkedIn sobre Apollo.io',
    ],
  },
  {
    cuenta: 'Financers',
    industria: 'Fintech',
    periodo: '2023 a hoy',
    resumen:
      'Producción de todos los materiales comunicacionales digitales y operación del CRM como sistema central.',
    trabajo: [
      'Sitio web, decks de presentación y perfiles de redes',
      'HubSpot como CRM master, con webmaster a cargo',
      'Campaña de marketing digital pautada y orgánica',
    ],
  },
];
---

<section id="casos" class="border-b border-line/70">
  <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
    <div class="max-w-3xl">
      <p class="eyebrow">Casos de éxito</p>
      <h2 class="mt-5 text-3xl font-bold uppercase leading-tight tracking-tight md:text-4xl">
        Cuentas que hoy prospectan con un sistema
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-muted">
        Cada una arrancó en un punto distinto. En todas el trabajo fue el mismo, ordenar el
        acercamiento inicial y sostenerlo en el tiempo.
      </p>
    </div>

    <div class="mt-14 grid gap-px border border-line bg-line md:grid-cols-2">
      {
        casos.map((c) => (
          <article class="flex flex-col bg-paper px-7 py-9 md:px-9">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="text-xl font-bold uppercase tracking-tight">{c.cuenta}</h3>
              <span class="text-xs uppercase tracking-[0.14em] text-muted">{c.periodo}</span>
            </div>
            <p class="mt-1 text-sm uppercase tracking-[0.14em] text-accent">{c.industria}</p>

            <p class="mt-5 text-base leading-relaxed text-muted">{c.resumen}</p>

            <ul class="mt-6 space-y-3 border-t border-line pt-6">
              {c.trabajo.map((t) => (
                <li class="flex gap-3 text-sm leading-relaxed text-muted">
                  <span aria-hidden="true" class="mt-2 h-px w-4 shrink-0 bg-accent" />
                  <span>{t}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
