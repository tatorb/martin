---
import { PAGE_INSET, PAGE_RADIUS } from './HeaderShape.astro';
import Cta from './Cta.astro';

// Sistema de trabajo, copiado del deck de discovery.
const etapas = [
  {
    n: '1',
    fuerte: 'Diseño',
    resto: 'de estrategia',
    texto:
      'Definimos el perfil de cuenta objetivo, los criterios de segmentación y el enfoque de abordaje según tu oferta, mercado y tipo de venta.',
  },
  {
    n: '2',
    fuerte: 'Set up',
    resto: 'del sistema',
    texto:
      'Configuramos el sistema de acceso comercial, cuentas, decisores reales, canales, mensajes y herramientas necesarias para ejecutar de forma consistente.',
  },
  {
    n: '3',
    fuerte: 'Ejecución',
    resto: 'de campañas',
    texto:
      'Activamos contactos directos y contextualizados con decisores clave, priorizando relevancia, timing y encaje con el negocio.',
  },
  {
    n: '4',
    fuerte: 'Hand off',
    resto: 'a comercial',
    texto:
      'Entregamos la oportunidad calificada al vendedor senior y acompañamos la transición para asegurar continuidad y correcta gestión comercial.',
    destacada: true,
  },
];

// Franja de resultados del mismo deck.
const resultados = [
  { icono: 'diana', texto: '8 a 12 conversaciones mensuales' },
  { icono: 'persona', texto: 'con decisores reales' },
  { icono: 'edificio', texto: 'en cuentas claves' },
  { icono: 'tendencia', texto: 'para sumar al pipeline' },
];

// Lo que entra en el programa, según los roles y recursos de la propuesta.
const beneficios = [
  {
    titulo: 'Ejecutivo de prospección',
    texto:
      'Gestiona los prospectos todos los días, incorpora contactos nuevos a las secuencias y sigue de cerca a los que muestran interés.',
  },
  {
    titulo: 'Especialista en implementación',
    texto:
      'Garantiza que el ecosistema funcione, configuración de herramientas, integraciones con el CRM y mantenimiento operativo.',
  },
  {
    titulo: 'Consultor dedicado',
    texto:
      'Aporta la mirada estratégica y ajusta mensajes, secuencias y enfoques de contacto en función de lo que muestran las métricas.',
  },
  {
    titulo: 'Agente de IA dedicado',
    texto:
      'Analiza y prioriza las empresas y los contactos con más potencial, para llegar antes a las oportunidades que valen.',
  },
  {
    titulo: 'Tablero de performance',
    texto:
      'Los resultados a la vista en HubSpot, para que puedas mirar el desempeño de la campaña día a día sin pedirnos nada.',
  },
  {
    titulo: 'Reunión semanal de alineación',
    texto:
      'Una hora por semana para revisar las métricas clave, compartir aprendizajes y ajustar la estrategia sin esperar al cierre de mes.',
  },
];
---

<section id="sistema" style={`padding:0 ${PAGE_INSET}px`}>
  <div class="bg-paper" style={`border-radius:${PAGE_RADIUS}px`}>
  <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
    <div class="max-w-3xl">
      <h2 class="text-3xl font-normal leading-tight tracking-tight md:text-4xl">
        Sistema de trabajo
      </h2>
    </div>

    <ol class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {
        etapas.map((e) => (
          <li
            class:list={[
              'rounded-[10px] border p-7',
              e.destacada ? 'border-ink bg-ink text-paper' : 'border-line bg-mist',
            ]}
          >
            <span
              class:list={[
                'block text-3xl font-light leading-none',
                e.destacada ? 'text-line' : 'text-muted',
              ]}
            >
              {e.n}
            </span>
            <p class="mt-6 text-lg uppercase leading-snug tracking-tight">
              <span class="font-bold">{e.fuerte}</span>
              <span class="block font-normal">{e.resto}</span>
            </p>
            <p
              class:list={['mt-5 text-sm leading-relaxed', e.destacada ? 'text-line' : 'text-muted']}
            >
              {e.texto}
            </p>
          </li>
        ))
      }
    </ol>

    <h3 class="mt-16 text-2xl font-normal tracking-tight md:text-3xl">Resultados</h3>

    <ul class="mt-6 grid gap-px overflow-hidden rounded-[10px] border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {
        resultados.map((r) => (
          <li class="flex flex-col items-center gap-4 bg-mist px-6 py-9 text-center">
            <svg
              width="26"
              height="26"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="text-ink"
            >
              {r.icono === 'diana' && (
                <g>
                  <circle cx="12" cy="12" r="8" />
                  <circle cx="12" cy="12" r="3.4" />
                </g>
              )}
              {r.icono === 'persona' && (
                <g>
                  <circle cx="10" cy="8" r="3.6" />
                  <path d="M3.5 20c0-3.6 2.9-6.5 6.5-6.5 1.3 0 2.5.4 3.5 1" />
                  <path d="M15.5 17.5l2 2 4-4" />
                </g>
              )}
              {r.icono === 'edificio' && (
                <g>
                  <path d="M5 21V5.5C5 4.7 5.7 4 6.5 4h7c.8 0 1.5.7 1.5 1.5V21" />
                  <path d="M15 10h3.5c.8 0 1.5.7 1.5 1.5V21" />
                  <path d="M3 21h18M8.5 8h3M8.5 12h3M8.5 16h3" />
                </g>
              )}
              {r.icono === 'tendencia' && (
                <g>
                  <path d="M3 17l6-6 4 4 8-8" />
                  <path d="M15 7h6v6" />
                </g>
              )}
            </svg>
            <span class="text-sm leading-relaxed text-muted">{r.texto}</span>
          </li>
        ))
      }
    </ul>

    <p
      class="mt-14 rounded-[10px] border border-line border-l-2 border-l-accent bg-mist px-7 py-8 text-lg leading-relaxed text-ink md:px-9 md:text-xl"
    >
      La mayoría de las reuniones se agenda entre el quinto y el octavo seguimiento. Por eso
      trabajamos con cadenas de siete contactos y no soltamos una cuenta después del segundo
      mensaje. El trabajo de hoy son las agendas de dentro de dos a cuatro semanas.
    </p>

    <div class="mt-20">
      <h3 class="text-2xl font-normal tracking-tight md:text-3xl">
        Qué recibís todos los meses
      </h3>

      <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          beneficios.map((b) => (
            <div class="rounded-[10px] border border-line bg-mist p-7">
              <h4 class="text-sm font-semibold uppercase tracking-[0.14em] text-accent">
                {b.titulo}
              </h4>
              <p class="mt-4 text-base leading-relaxed text-muted">{b.texto}</p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-14">
      <Cta label="Agendar la primera reunión" pixel="boton_sistema" />
    </div>
  </div>
  </div>
</section>
