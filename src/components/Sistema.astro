---
import Cta from './Cta.astro';

// Etapas y plazos, tal cual figuran en la propuesta de trabajo.
const etapas = [
  {
    n: '01',
    titulo: 'Definimos',
    dia: 'Día 0',
    bajada: 'tu negocio, el cliente ideal, el recorrido de compra, los dolores y los diferenciales.',
    puntos: [
      'Industria',
      'Organización',
      'Producto',
      'Competencia',
      'Diferencial',
      'Cliente',
      'Dolor del cliente',
      'Soluciones',
    ],
  },
  {
    n: '02',
    titulo: 'Diseñamos',
    dia: 'Día 5',
    bajada: 'las secuencias y los mensajes según cada canal.',
    puntos: [
      'Seleccionar plataforma',
      'Definir hooks según dolor y solución',
      'Diseñar secuencia y mensajes',
      'Definir segmentación',
      'Definir remitente de campaña',
    ],
  },
  {
    n: '03',
    titulo: 'Producimos',
    dia: 'Día 10',
    bajada: 'los recursos, configuramos las herramientas y conectamos el CRM.',
    puntos: ['Setup de herramientas', 'Integración con CRM', 'Setup de secuencias'],
  },
  {
    n: '04',
    titulo: 'Ejecutamos',
    dia: 'Día 20',
    bajada: 'y hacemos seguimiento diario, con asesoría permanente.',
    puntos: ['Seguimiento diario de campaña', 'Asesoría constante', 'Reuniones semanales'],
  },
];

// Lo que entra en el programa, según los roles y recursos de la propuesta.
const beneficios = [
  {
    titulo: 'Ejecutivo de prospección',
    texto:
      'Gestiona los prospectos todos los días, incorpora contactos nuevos a las secuencias y sigue de cerca a los que muestran interés.',
  },
  {
    titulo: 'Especialista en implementación',
    texto:
      'Garantiza que el ecosistema funcione, configuración de herramientas, integraciones con el CRM y mantenimiento operativo.',
  },
  {
    titulo: 'Consultor dedicado',
    texto:
      'Aporta la mirada estratégica y ajusta mensajes, secuencias y enfoques de contacto en función de lo que muestran las métricas.',
  },
  {
    titulo: 'Agente de IA dedicado',
    texto:
      'Analiza y prioriza las empresas y los contactos con más potencial, para llegar antes a las oportunidades que valen.',
  },
  {
    titulo: 'Tablero de performance',
    texto:
      'Los resultados a la vista en HubSpot, para que puedas mirar el desempeño de la campaña día a día sin pedirnos nada.',
  },
  {
    titulo: 'Reunión semanal de alineación',
    texto:
      'Una hora por semana para revisar las métricas clave, compartir aprendizajes y ajustar la estrategia sin esperar al cierre de mes.',
  },
];
---

<section id="sistema" class="border-b border-line/70">
  <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
    <div class="max-w-3xl">
      <p class="eyebrow">Cómo trabajamos</p>
      <h2 class="mt-5 text-3xl font-bold uppercase leading-tight tracking-tight md:text-4xl">
        Veinte días desde la primera reunión hasta el primer mensaje enviado
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-muted">
        Cuatro etapas, cada una con un entregable concreto. Los plazos suponen que estés disponible
        para aprobar contenido, dar accesos y sostener las reuniones acordadas.
      </p>
    </div>

    <ol class="mt-14 grid gap-px border border-line bg-line md:grid-cols-2 lg:grid-cols-4">
      {
        etapas.map((e) => (
          <li class="flex flex-col bg-paper px-7 py-9">
            <div class="flex items-baseline justify-between">
              <span class="text-4xl font-bold tracking-tight text-line">{e.n}</span>
              <span class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">
                {e.dia}
              </span>
            </div>

            <h3 class="mt-6 text-xl font-bold uppercase tracking-tight">{e.titulo}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">{e.bajada}</p>

            <ul class="mt-6 space-y-2 border-t border-line pt-6 text-sm text-muted">
              {e.puntos.map((p) => (
                <li class="flex gap-3">
                  <span aria-hidden="true" class="mt-2 h-px w-3 shrink-0 bg-line" />
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <p
      class="mt-14 border-l-2 border-accent bg-mist px-7 py-8 text-lg leading-relaxed text-ink md:px-9 md:text-xl"
    >
      La mayoría de las reuniones se agenda entre el quinto y el octavo seguimiento. Por eso
      trabajamos con cadenas de siete contactos y no soltamos una cuenta después del segundo
      mensaje. El trabajo de hoy son las agendas de dentro de dos a cuatro semanas.
    </p>

    <div class="mt-20">
      <h3 class="text-2xl font-bold uppercase tracking-tight md:text-3xl">
        Qué recibís todos los meses
      </h3>

      <div class="mt-10 grid gap-px border border-line bg-line md:grid-cols-2 lg:grid-cols-3">
        {
          beneficios.map((b) => (
            <div class="bg-paper px-7 py-8">
              <h4 class="text-sm font-semibold uppercase tracking-[0.14em] text-accent">
                {b.titulo}
              </h4>
              <p class="mt-4 text-base leading-relaxed text-muted">{b.texto}</p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-14">
      <Cta label="Agendar la primera reunión" />
    </div>
  </div>
</section>
