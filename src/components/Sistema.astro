---
import { PAGE_INSET, PAGE_RADIUS } from './HeaderShape.astro';

// Sistema de trabajo, copiado del deck de discovery.
const etapas = [
  {
    n: '1',
    fuerte: 'Diseño',
    resto: 'de estrategia',
    texto:
      'Definimos el perfil de cuenta objetivo, los criterios de segmentación y el enfoque de abordaje según tu oferta, mercado y tipo de venta.',
  },
  {
    n: '2',
    fuerte: 'Set up',
    resto: 'del sistema',
    texto:
      'Configuramos el sistema de acceso comercial, cuentas, decisores reales, canales, mensajes y herramientas necesarias para ejecutar de forma consistente.',
  },
  {
    n: '3',
    fuerte: 'Ejecución',
    resto: 'de campañas',
    texto:
      'Activamos contactos directos y contextualizados con decisores clave, priorizando relevancia, timing y encaje con el negocio.',
  },
  {
    n: '4',
    fuerte: 'Hand off',
    resto: 'a comercial',
    texto:
      'Entregamos la oportunidad calificada al vendedor senior y acompañamos la transición para asegurar continuidad y correcta gestión comercial.',
    destacada: true,
  },
];

// Franja de resultados del mismo deck.
const resultados = [
  { icono: 'diana', texto: '8 a 12 conversaciones mensuales' },
  { icono: 'persona', texto: 'con decisores reales' },
  { icono: 'edificio', texto: 'en cuentas claves' },
  { icono: 'tendencia', texto: 'para sumar al pipeline' },
];

---

<section id="sistema" style={`padding:0 ${PAGE_INSET}px`}>
  <div class="bg-paper" style={`border-radius:${PAGE_RADIUS}px`}>
  <div class="mx-auto max-w-6xl px-6 py-20 text-center md:py-28">
    <div class="aparece mx-auto max-w-3xl">
      <h2 class="text-3xl font-normal leading-tight tracking-tight md:text-4xl">
        Sistema de trabajo
      </h2>
    </div>

    {/* Cards altas, con la etiqueta de etapa arriba, el título grande y la
        descripción en chico. La destacada va en degradé oscuro con sombra, que
        es lo único que la diferencia del resto. */}
    <ol class="mt-14 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      {
        etapas.map((e, i) => (
          <li
            style={`transition-delay:${i * 90}ms`}
            class:list={[
              'aparece flex min-h-[250px] flex-col items-center rounded-[14px] p-4 sm:min-h-[320px] sm:p-6',
              e.destacada
                ? 'destacada text-paper shadow-[0_18px_40px_-18px_rgba(0,0,0,0.55)]'
                : 'border border-line bg-mist',
            ]}
          >
            <span
              class:list={[
                'self-center rounded-full px-3 py-1 text-xs tracking-tight',
                e.destacada ? 'bg-white/15 text-paper' : 'bg-paper text-muted',
              ]}
            >
              Etapa {e.n}
            </span>

            <h3 class="mt-5 text-base font-normal leading-snug tracking-tight sm:mt-6 sm:text-xl md:text-2xl">
              {e.fuerte} {e.resto}
            </h3>

            <p
              class:list={[
                'mt-3 text-xs leading-relaxed sm:mt-4 sm:text-sm',
                e.destacada ? 'text-line' : 'text-muted',
              ]}
            >
              {e.texto}
            </p>
          </li>
        ))
      }
    </ol>

    <h3 class="aparece mt-16 text-2xl font-normal tracking-tight md:text-3xl">Resultados</h3>

    <ul class="aparece mt-6 grid gap-px overflow-hidden rounded-[10px] border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {
        resultados.map((r) => (
          <li class="flex flex-col items-center gap-4 bg-mist px-6 py-9 text-center">
            <svg
              width="26"
              height="26"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="text-ink"
            >
              {r.icono === 'diana' && (
                <g>
                  <circle cx="12" cy="12" r="8" />
                  <circle cx="12" cy="12" r="3.4" />
                </g>
              )}
              {r.icono === 'persona' && (
                <g>
                  <circle cx="10" cy="8" r="3.6" />
                  <path d="M3.5 20c0-3.6 2.9-6.5 6.5-6.5 1.3 0 2.5.4 3.5 1" />
                  <path d="M15.5 17.5l2 2 4-4" />
                </g>
              )}
              {r.icono === 'edificio' && (
                <g>
                  <path d="M5 21V5.5C5 4.7 5.7 4 6.5 4h7c.8 0 1.5.7 1.5 1.5V21" />
                  <path d="M15 10h3.5c.8 0 1.5.7 1.5 1.5V21" />
                  <path d="M3 21h18M8.5 8h3M8.5 12h3M8.5 16h3" />
                </g>
              )}
              {r.icono === 'tendencia' && (
                <g>
                  <path d="M3 17l6-6 4 4 8-8" />
                  <path d="M15 7h6v6" />
                </g>
              )}
            </svg>
            <span class="text-sm leading-relaxed text-muted">{r.texto}</span>
          </li>
        ))
      }
    </ul>
  </div>
  </div>
</section>

<style>
  /* Mismo degradé que tenía el hero, para no inventar otro oscuro. */
  .destacada {
    background: linear-gradient(160deg, #3b4349 0%, #20262a 48%, #0e1113 100%);
  }
</style>
