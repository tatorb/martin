---
import Cta from './Cta.astro';
import Logo from './Logo.astro';
import HeaderShape, {
  BLOCK_H,
  CAP_W,
  PAGE_INSET,
  PAGE_RADIUS,
  STRIP_PCT,
} from './HeaderShape.astro';

// El contenido se alinea con la zona plana de la barra, corriéndose lo que ocupan
// la tira y el mordido de cada lado. Así nunca se mete sobre las curvas.
const contentInset = `calc(${STRIP_PCT}% + ${CAP_W}px)`;

// Padding interno de la barra en el sitio institucional.
const BAR_PAD = 15;
---

{/* Fijo, como en el sitio institucional. Lleva el mismo margen lateral que el
    contenedor del hero para que la silueta quede contenida dentro del bloque.
    La sombra apenas insinuada es lo que la separa de las secciones claras, donde
    la silueta blanca no tendría contra qué recortarse. */}
<header
  class="fixed inset-x-0 top-0 z-50 drop-shadow-[0_1px_3px_rgba(0,0,0,0.10)]"
  style={`height:${BLOCK_H}px;padding:0 ${PAGE_INSET}px`}
>
  {/* El recorte va acá y no en cada tira. Si cada pieza llevara su propio radio,
      CSS lo achicaría al no entrar en los 20px de alto de la tira, y no empalmaría
      con la esquina del contenedor del hero. Recortando todo el bloque con el mismo
      radio, las dos esquinas coinciden. */}
  <div
    class="relative h-full overflow-hidden"
    style={`border-radius:${PAGE_RADIUS}px ${PAGE_RADIUS}px 0 0`}
  >
    <HeaderShape />

    <div
      class="relative flex h-full items-center justify-between gap-4"
      style={`margin:0 ${contentInset};padding:0 ${BAR_PAD}px`}
    >
      <a href="#contenido" class="text-ink" aria-label="Studio MRB, inicio">
        {/* 20px, la proporción que tiene contra el botón de 35px en el original.
            Va como clase literal porque Tailwind no detecta clases construidas. */}
        <Logo class="h-5" />
      </a>

      <Cta label="Agendar" size="sm" icon={false} />
    </div>
  </div>
</header>
