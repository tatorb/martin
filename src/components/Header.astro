---
import Cta from './Cta.astro';
import Logo from './Logo.astro';
import HeaderShape, { BLOCK_H, CENTER_W, CAP_W, PAGE_INSET } from './HeaderShape.astro';

// El contenido vive siempre dentro de la zona plana. Al restar las dos tapas,
// en pantallas angostas tampoco se mete sobre las curvas.
const contentW = CENTER_W - CAP_W * 2;
const contentWidth = `min(${contentW}px, 100% - ${CAP_W * 2}px)`;

// Padding interno de la barra en el sitio institucional.
const BAR_PAD = 15;
---

{/* Fijo, como en el sitio institucional. Lleva el mismo margen lateral que el
    contenedor del hero para que la silueta quede contenida dentro del bloque.
    La sombra apenas insinuada es lo que la separa de las secciones claras, donde
    la silueta blanca no tendría contra qué recortarse. */}
<header
  class="fixed inset-x-0 top-0 z-50 drop-shadow-[0_1px_3px_rgba(0,0,0,0.10)]"
  style={`height:${BLOCK_H}px;padding:0 ${PAGE_INSET}px`}
>
  <div class="relative h-full">
    <HeaderShape />

    <div
      class="relative mx-auto flex h-full items-center justify-between gap-4"
      style={`width:${contentWidth};padding:0 ${BAR_PAD}px`}
    >
      <a href="#contenido" class="text-ink" aria-label="Studio MRB, inicio">
        {/* 20px, la proporción que tiene contra el botón de 35px en el original.
            Va como clase literal porque Tailwind no detecta clases construidas. */}
        <Logo class="h-5" />
      </a>

      <Cta label="Agendar" size="sm" />
    </div>
  </div>
</header>
