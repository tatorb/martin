---
// Silueta del header, como en studiomrb.com. Una tira fina de lateral a lateral
// que en el centro se ensancha, con curvas invertidas en las dos transiciones.
//
// La forma se parte en cinco piezas para que solo estiren los tramos rectos.
// Las tapas son SVG de ancho fijo, así las curvas nunca se deforman.
// Medidas del sitio institucional, tira de 20px y barra de 44px.
export const STRIP_H = 20; // alto de la tira fina
export const BLOCK_H = 44; // alto de la parte ancha

// Los dos arcos tienen que repartirse el salto de altura, 44 menos 20, o sea 24.
// Con radio 12 cada uno cubre justo la mitad, se tocan con tangente vertical y no
// queda tramo recto. Es el radio más grande que entra en una barra de 44.
export const RADIUS = (BLOCK_H - STRIP_H) / 2;
export const CAP_W = RADIUS * 2; // el ancho de la tapa lo fija el radio
export const CENTER_W = 1240; // ancho total de la parte ancha, curvas incluidas
export const PAGE_INSET = 10; // margen lateral del contenedor del hero
export const PAGE_RADIUS = 28; // radio de sus esquinas, que la silueta tiene que respetar
export const FLAT_W = CENTER_W - CAP_W * 2;

// La transición son dos arcos de círculo tangentes, no una Bézier. El primero
// sale horizontal desde la parte ancha y llega vertical, el segundo arranca
// vertical y sale horizontal sobre la tira fina. Así el empalme entre curva y
// contracurva es exactamente vertical, no una aproximación.
//
// Con el radio en la mitad exacta del salto los dos arcos se tocan y el tramo
// recto entre ellos queda en cero, que es el caso límite.
const capPath = [
  `M 0,0`,
  `L ${CAP_W},0`,
  `L ${CAP_W},${BLOCK_H}`,
  `A ${RADIUS} ${RADIUS} 0 0 1 ${CAP_W - RADIUS},${BLOCK_H - RADIUS}`,
  `L ${CAP_W - RADIUS},${STRIP_H + RADIUS}`,
  `A ${RADIUS} ${RADIUS} 0 0 0 0,${STRIP_H}`,
  `Z`,
].join(' ');
---

<div
  aria-hidden="true"
  class="pointer-events-none absolute inset-x-0 top-0 flex justify-center text-paper"
  style={`height:${BLOCK_H}px`}
>
  <div
    class="flex-1 bg-current"
    style={`height:${STRIP_H}px;border-top-left-radius:${PAGE_RADIUS}px`}
  >
  </div>

  <svg
    width={CAP_W}
    height={BLOCK_H}
    viewBox={`0 0 ${CAP_W} ${BLOCK_H}`}
    fill="currentColor"
    class="shrink-0"
  >
    <path d={capPath}></path>
  </svg>

  <div class="bg-current" style={`height:${BLOCK_H}px;width:min(${FLAT_W}px,100%)`}></div>

  <svg
    width={CAP_W}
    height={BLOCK_H}
    viewBox={`0 0 ${CAP_W} ${BLOCK_H}`}
    fill="currentColor"
    class="shrink-0 -scale-x-100"
  >
    <path d={capPath}></path>
  </svg>

  <div
    class="flex-1 bg-current"
    style={`height:${STRIP_H}px;border-top-right-radius:${PAGE_RADIUS}px`}
  >
  </div>
</div>
