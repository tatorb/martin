---
// Silueta del header, como en studiomrb.com. Una tira fina de lateral a lateral
// que en el centro se ensancha, con curvas invertidas en las dos transiciones.
//
// La forma se parte en cinco piezas para que solo estiren los tramos rectos.
// Las tapas son SVG de ancho fijo, así las curvas nunca se deforman.
// Medidas del sitio institucional. La tira mide 20px y la parte ancha 44px más,
// contados por debajo de la tira, así que el alto total del bloque es 64.
export const STRIP_H = 20; // alto de la tira fina
export const BLOCK_H = 64; // alto total de la parte ancha, tira incluida

// La pieza de 20 x 20 del original es toda la zona de transición, no un arco.
// Los dos arcos se reparten ese ancho, así que el radio es 10. El resto del
// salto de altura, 44 menos los 20 que cubren los arcos, queda como tramo recto
// vertical, que es lo que hace que el mordido se lea discreto.
export const RADIUS = 10;
export const CAP_W = RADIUS * 2; // el ancho de la tapa lo fija el radio
export const PAGE_INSET = 10; // margen lateral del contenedor del hero
export const PAGE_RADIUS = 10; // radio de sus esquinas, el mismo que el del mordido

// La tira no es un sobrante, es proporcional. Medido en el sitio institucional
// a 1070px de viewport, donde el bloque disponible es 1050, la tira mide 48.72
// por lado. De ahí el 4.64 por ciento. Los 20 del mordido y el resto para la
// barra completan los 1050 exactos.
export const STRIP_PCT = 4.64;

// La transición son dos arcos de círculo tangentes, no una Bézier. El primero
// sale horizontal desde la parte ancha y llega vertical, el segundo arranca
// vertical y sale horizontal sobre la tira fina. Así el empalme entre curva y
// contracurva es exactamente vertical, no una aproximación.
//
// Como el radio es menor que la mitad del salto de altura, entre los dos arcos
// queda además un tramo recto vertical, igual que en la referencia.
const capPath = [
  `M 0,0`,
  `L ${CAP_W},0`,
  `L ${CAP_W},${BLOCK_H}`,
  `A ${RADIUS} ${RADIUS} 0 0 1 ${CAP_W - RADIUS},${BLOCK_H - RADIUS}`,
  `L ${CAP_W - RADIUS},${STRIP_H + RADIUS}`,
  `A ${RADIUS} ${RADIUS} 0 0 0 0,${STRIP_H}`,
  `Z`,
].join(' ');

// Terminación de los extremos. Recorriendo el contorno de derecha a izquierda,
// el borde inferior de la tira llega hasta 20px antes del lateral de la página,
// ahí baja con un arco del mismo radio 10 y sale con tangente vertical, y desde
// ese punto sube recto hasta el tope, donde gira 90 grados hacia el centro.
//
// La vertical cae sobre los 10px del margen lateral, así que queda alineada con
// el borde de los contenedores de la página.
const END_W = RADIUS; // el arco recorre un radio en horizontal
const END_DROP = STRIP_H + RADIUS; // hasta dónde baja el gancho del extremo
const endPath = [
  `M 0,0`,
  `L ${END_W},0`,
  `L ${END_W},${STRIP_H}`,
  `A ${RADIUS} ${RADIUS} 0 0 0 0,${END_DROP}`,
  `Z`,
].join(' ');
---

<div
  aria-hidden="true"
  class="pointer-events-none absolute inset-x-0 top-0 flex justify-center text-paper"
  style={`height:${BLOCK_H}px`}
>
  <svg
    width={END_W}
    height={BLOCK_H}
    viewBox={`0 0 ${END_W} ${BLOCK_H}`}
    fill="currentColor"
    class="shrink-0"
  >
    <path d={endPath}></path>
  </svg>

  <div
    class="bg-current"
    style={`flex:0 0 calc(${STRIP_PCT}% - ${END_W}px);height:${STRIP_H}px`}
  >
  </div>

  <svg
    width={CAP_W}
    height={BLOCK_H}
    viewBox={`0 0 ${CAP_W} ${BLOCK_H}`}
    fill="currentColor"
    class="shrink-0"
  >
    <path d={capPath}></path>
  </svg>

  <div class="flex-1 bg-current" style={`height:${BLOCK_H}px`}></div>

  <svg
    width={CAP_W}
    height={BLOCK_H}
    viewBox={`0 0 ${CAP_W} ${BLOCK_H}`}
    fill="currentColor"
    class="shrink-0 -scale-x-100"
  >
    <path d={capPath}></path>
  </svg>

  <div
    class="bg-current"
    style={`flex:0 0 calc(${STRIP_PCT}% - ${END_W}px);height:${STRIP_H}px`}
  >
  </div>

  <svg
    width={END_W}
    height={BLOCK_H}
    viewBox={`0 0 ${END_W} ${BLOCK_H}`}
    fill="currentColor"
    class="shrink-0 -scale-x-100"
  >
    <path d={endPath}></path>
  </svg>
</div>
