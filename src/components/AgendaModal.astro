---
import { CALENDAR_EMBED_URL, CONTACT } from '../site.config';
import { PAGE_RADIUS } from './HeaderShape.astro';

// El calendario se abre en un diálogo en vez de mandar al visitante a otra
// sección. Se usa el elemento dialog nativo, que ya trae cierre con Escape,
// foco atrapado dentro y fondo inerte, sin librerías.
---

<dialog
  id="modal-agenda"
  aria-label="Agendar una reunión"
  {/* El m-auto es necesario. El preflight de Tailwind pone margin 0 en todo y eso
      pisa el margin auto con el que el navegador centra un dialog modal. */}
  class="m-auto w-[min(1000px,94vw)] border-0 bg-transparent p-0 backdrop:bg-black/60"
>
  <div
    class="relative overflow-hidden bg-paper"
    style={`border-radius:${PAGE_RADIUS}px;height:min(920px, 88vh)`}
  >
    <button
      type="button"
      data-cerrar
      aria-label="Cerrar"
      class="absolute right-3 top-3 z-10 flex h-9 w-9 items-center justify-center rounded-md bg-paper text-ink transition-colors hover:bg-mist"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.7" />
      </svg>
    </button>

    {
      CALENDAR_EMBED_URL ? (
        // El iframe se inyecta al abrir por primera vez. Si se dejara acá, el
        // calendario se descargaría en cada visita aunque nadie lo abra.
        <div id="modal-agenda-marco" class="h-full w-full" data-src={CALENDAR_EMBED_URL} />
      ) : (
        <div class="flex h-full flex-col items-center justify-center px-6 text-center">
          <p class="text-sm font-semibold uppercase tracking-[0.14em] text-muted">
            Falta cargar el calendario
          </p>
          <p class="mt-4 text-sm text-muted">
            Escribile directo a{' '}
            <a
              href={`mailto:${CONTACT.email}`}
              class="text-ink underline decoration-line underline-offset-4"
            >
              {CONTACT.email}
            </a>
          </p>
        </div>
      )
    }
  </div>
</dialog>

<script>
  const modal = document.getElementById('modal-agenda') as HTMLDialogElement | null;
  const marco = document.getElementById('modal-agenda-marco');

  // Guarda en memoria. Vive lo que vive la pestaña, así que un mismo visitante
  // que toque varios botones cuenta una sola vez. No se persiste a propósito.
  let leadEnviado = false;

  /**
   * Evento Lead del píxel de Meta. No devuelve nada ni espera nada, fbq encola
   * y sigue, así que el clic no se retrasa. El try es por si un bloqueador
   * dejó fbq sin definir, para que eso no corte la apertura del calendario.
   */
  function registrarLead(enlace: HTMLAnchorElement) {
    if (leadEnviado) return;
    const fbq = (window as any).fbq;
    if (typeof fbq !== 'function') return;
    leadEnviado = true;
    try {
      fbq('track', 'Lead', { content_name: enlace.dataset.lead ?? 'boton_agenda' });
    } catch {
      /* el píxel no debe romper la navegación */
    }
  }

  function abrir(this: HTMLAnchorElement, evento: Event) {
    registrarLead(this);

    if (!modal) return; // sin diálogo, el enlace hace lo suyo y lleva a la sección
    evento.preventDefault();

    // Carga diferida, una sola vez.
    if (marco && !marco.querySelector('iframe')) {
      const iframe = document.createElement('iframe');
      iframe.src = marco.dataset.src ?? '';
      iframe.title = 'Calendario para agendar una reunión con Studio MRB';
      iframe.className = 'h-full w-full';
      marco.appendChild(iframe);
    }

    modal.showModal();

    // DIAGNÓSTICO TEMPORAL, BORRAR DESPUÉS. Ver el bloque del final del archivo.
    escucharMensajes();
  }

  // Todo enlace que apunte al ancla de agenda, esté en la home o en otra página.
  document.querySelectorAll<HTMLAnchorElement>('a[href$="#agenda"]').forEach((enlace) => {
    enlace.addEventListener('click', abrir);
  });

  modal?.querySelector('[data-cerrar]')?.addEventListener('click', () => modal.close());

  // Clic en el fondo. El dialog recibe el evento cuando se toca el backdrop,
  // porque el contenido está en un hijo que lo cubre por completo.
  modal?.addEventListener('click', (evento) => {
    if (evento.target === modal) modal.close();
  });

  // ===========================================================================
  // DIAGNÓSTICO TEMPORAL, BORRAR DESPUÉS.
  //
  // Sirve para averiguar si el widget de citas de Google avisa algo a la página
  // cuando alguien confirma una reserva. Escucha todos los postMessage que
  // lleguen a la ventana mientras el modal está abierto, sin filtrar ninguno,
  // y los muestra en la consola.
  //
  // Para sacarlo: borrar este bloque entero y la llamada a escucharMensajes()
  // que está dentro de la función abrir().
  // ===========================================================================
  const registro: unknown[] = [];
  (window as any).mensajesAgenda = registro;
  let escuchando = false;

  function espiar(evento: MessageEvent) {
    const entrada = {
      hora: new Date().toISOString(),
      origen: evento.origin,
      datos: evento.data,
      tipoDeDatos: typeof evento.data,
      vieneDelIframe: evento.source === marco?.querySelector('iframe')?.contentWindow,
    };
    registro.push(entrada);

    console.log('%c[AGENDA] mensaje ' + registro.length, 'background:#5b7382;color:#fff;padding:2px 6px');
    console.log('  origen:', evento.origin);
    console.log('  datos:', evento.data);
    // Si el contenido es un objeto, esta copia en texto es la más fácil de pegar.
    try {
      console.log('  datos como texto:', JSON.stringify(evento.data));
    } catch {
      console.log('  datos como texto: (no se puede convertir)');
    }
  }

  function escucharMensajes() {
    if (escuchando) return;
    escuchando = true;
    window.addEventListener('message', espiar);
    console.log(
      '%c[AGENDA] escuchando mensajes del calendario. Al terminar, escribí: copy(mensajesAgenda)',
      'background:#000;color:#fff;padding:2px 6px'
    );
  }

  // Deja de escuchar al cerrar, como pediste. El registro queda igual en
  // window.mensajesAgenda, así que no se pierde nada de lo ya capturado.
  modal?.addEventListener('close', () => {
    window.removeEventListener('message', espiar);
    escuchando = false;
    console.log('%c[AGENDA] modal cerrado. Mensajes capturados: ' + registro.length,
      'background:#000;color:#fff;padding:2px 6px');
  });
  // ======================= FIN DEL DIAGNÓSTICO TEMPORAL ======================
</script>
