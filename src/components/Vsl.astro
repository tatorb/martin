---
import { PAGE_INSET, PAGE_RADIUS } from './HeaderShape.astro';
import Cta from './Cta.astro';
import { VSL_EMBED_URL, VSL_POSTER_URL } from '../site.config';
import { urlDeEmbed } from '../lib/video';
import Reproductor from './Reproductor.astro';

// Cuando hay póster mostramos una fachada y cargamos el iframe recién al hacer clic,
// así la página no arranca pidiendo el video.
const usaFachada = Boolean(VSL_EMBED_URL && VSL_POSTER_URL);
const embed = urlDeEmbed(VSL_EMBED_URL);
---

<section style={`padding:0 ${PAGE_INSET}px`}>
  <div class="bg-paper" style={`border-radius:${PAGE_RADIUS}px`}>
  <div class="mx-auto max-w-6xl px-6 pb-20 pt-12 text-center md:pb-28 md:pt-14">
    <div class="mx-auto max-w-4xl">
      {
        VSL_EMBED_URL ? (
          usaFachada ? (
            <div
              id="vsl"
              class="relative aspect-video w-full overflow-hidden rounded-[10px] bg-ink"
              data-embed={embed}
            >
              <img
                src={VSL_POSTER_URL}
                alt=""
                class="absolute inset-0 h-full w-full object-cover opacity-80"
              />
              <button
                type="button"
                class="group absolute inset-0 flex items-center justify-center"
                aria-label="Reproducir el video"
              >
                <span class="flex h-20 w-20 items-center justify-center rounded-full bg-paper transition-transform duration-200 group-hover:scale-105">
                  <svg width="22" height="26" viewBox="0 0 22 26" aria-hidden="true">
                    <path d="M0 0l22 13L0 26z" fill="#000000" />
                  </svg>
                </span>
              </button>
            </div>
          ) : (
            <div
              class="relative aspect-video w-full overflow-hidden rounded-[10px] bg-ink"
            >
              <iframe
                src={embed}
                data-yt
                title="Apertura de Cuentas, Studio MRB"
                class="h-full w-full"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture"
                allowfullscreen
              />
            </div>
          )
        ) : (
          <div class="flex aspect-video w-full flex-col items-center justify-center rounded-[10px] border border-dashed border-line bg-mist px-6 text-center">
            <svg width="34" height="40" viewBox="0 0 22 26" aria-hidden="true" class="text-line">
              <path d="M0 0l22 13L0 26z" fill="currentColor" />
            </svg>
            <p class="mt-6 text-sm font-semibold uppercase tracking-[0.14em] text-muted">
              Espacio reservado para el VSL
            </p>
            <p class="mt-3 max-w-md text-sm leading-relaxed text-muted">
              Pegá la URL de embed del video en <code class="text-ink">VSL_EMBED_URL</code>, dentro
              de <code class="text-ink">src/site.config.ts</code>, y el reproductor aparece acá.
            </p>
          </div>
        )
      }
    </div>

    {/* El botón va pegado al video, que es el momento en que alguien decide
        agendar. Antes estaba al final de la sección. */}
    <div class="mt-10 flex justify-center">
      <Cta label="Agendar una reunión" variant="verde" pixel="boton_video" />
    </div>
  </div>
  </div>
</section>

<Reproductor />

{
  usaFachada && (
    <script>
      const marco = document.getElementById('vsl');
      marco?.querySelector('button')?.addEventListener('click', () => {
        const src = marco.dataset.embed;
        if (!src) return;
        const iframe = document.createElement('iframe');
        iframe.src = src.includes('?') ? `${src}&autoplay=1` : `${src}?autoplay=1`;
        iframe.title = 'Apertura de Cuentas, Studio MRB';
        iframe.dataset.yt = '';
        iframe.className = 'absolute inset-0 h-full w-full';
        iframe.allow =
          'accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture';
        iframe.allowFullscreen = true;
        marco.replaceChildren(iframe);
      });
    </script>
  )
}
