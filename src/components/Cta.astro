---
// Botón del sistema de Studio MRB, con las medidas del sitio institucional.
interface Props {
  label?: string;
  variant?: 'solid' | 'outline' | 'light';
  size?: 'sm' | 'md';
  /** La flecha va en los botones del cuerpo. El del header no la lleva. */
  icon?: boolean;
  class?: string;
}

const {
  label = 'Agendar una reunión',
  variant = 'solid',
  size = 'md',
  icon = true,
  class: extra = '',
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2.5 rounded-md font-medium transition-colors duration-200';

const sizes = {
  // Medidas del botón del sitio institucional, 15px Urbanist y padding 10px 20px,
  // que dan los 35px de alto del original.
  sm: 'px-5 py-[10px] text-[15px] leading-[15px]',
  md: 'px-8 py-3.5 text-base', // 52px de alto, para el cuerpo de la página
};

// El halo es el del sitio institucional, box-shadow 0 0 16px 6px rgba(0,0,0,0.51).
const halo = 'shadow-[0_0_16px_6px_rgba(0,0,0,0.51)]';

const styles = {
  solid: `bg-ink text-paper hover:bg-accent ${halo}`,
  outline: 'border border-ink text-ink hover:bg-ink hover:text-paper',
  light: `bg-paper text-ink hover:bg-line ${halo}`, // para fondos oscuros, como el hero
};
---

<a href="#agenda" class:list={[base, sizes[size], styles[variant], extra]}>
  {label}
  {
    icon && (
      <svg width="17" height="12" viewBox="0 0 17 12" fill="none" aria-hidden="true">
        <path d="M0 6h15M10.5 1l5 5-5 5" stroke="currentColor" stroke-width="1.5" />
      </svg>
    )
  }
</a>
