---
// Lockup horizontal de Studio MRB, como en studiomrb.com. "studio" en Urbanist
// liviano y "mrb" en trazados, unidos en una sola línea.
//
// El contenedor usa items-baseline. La línea de base de un SVG dentro de un flex
// es su borde inferior, que en este viewBox coincide con la base de la "mrb", así
// que las dos partes apoyan sobre la misma línea sin ajustes a ojo.
//
// La altura del SVG sale de igualar las alturas de x. La x de la "mrb" ocupa 290
// de las 368 unidades del viewBox y la de Urbanist ronda 0.52 del cuerpo, de ahí
// que el SVG vaya a 0.66em respecto del texto.
interface Props {
  class?: string;
}

const { class: extra = '' } = Astro.props;
---

<span class:list={['inline-flex items-baseline leading-none', extra]}>
  <span class="font-light lowercase tracking-[0.005em]">studio</span>
  <svg viewBox="0 0 770 368" class="h-[0.66em] w-auto" fill="currentColor" aria-hidden="true">
    <path
      fill-rule="evenodd"
      d="M 0,368 L 0,154 A 76 76 0 0 1 76,78 L 130,78 A 76 76 0 0 1 206,154 L 206,368 L 130,368 L 130,172 A 18 18 0 0 0 112,154 L 94,154 A 18 18 0 0 0 76,172 L 76,368 Z"
    ></path>
    <path
      fill-rule="evenodd"
      d="M 130,368 L 130,154 A 76 76 0 0 1 206,78 L 260,78 A 76 76 0 0 1 336,154 L 336,368 L 260,368 L 260,172 A 18 18 0 0 0 242,154 L 224,154 A 18 18 0 0 0 206,172 L 206,368 Z"
    ></path>
    <path
      fill-rule="evenodd"
      d="M 370,368 L 370,154 A 76 76 0 0 1 446,78 L 530,78 L 530,154 L 464,154 A 18 18 0 0 0 446,172 L 446,368 Z"
    ></path>
    <path
      fill-rule="evenodd"
      d="M 564,0 L 640,0 L 640,78 L 694,78 A 76 76 0 0 1 770,154 L 770,292 A 76 76 0 0 1 694,368 L 564,368 Z M 640,172 A 18 18 0 0 1 658,154 L 676,154 A 18 18 0 0 1 694,172 L 694,274 A 18 18 0 0 1 676,292 L 658,292 A 18 18 0 0 1 640,274 Z"
    ></path>
  </svg>
  <span class="sr-only">Studio MRB</span>
</span>
