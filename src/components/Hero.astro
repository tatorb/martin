---
import { PAGE_INSET, PAGE_RADIUS } from './HeaderShape.astro';
---

<!-- Ya no hay header fijo encima, así que el contenido no necesita despejar su
     alto: arranca con su propio aire. -->
<section id="contenido" style={`padding:0 ${PAGE_INSET}px`}>
  <div
    class="relative isolate overflow-hidden bg-mist text-ink"
    style={`border-radius:${PAGE_RADIUS}px`}
  >
    <div class="relative mx-auto flex max-w-4xl flex-col items-center px-6 pb-16 pt-14 text-center md:pb-20 md:pt-16">
      {/* A quién le habla la página, en la pastilla rosa de la marca. El ancho
          lo da el texto, así que en pantallas angostas la pastilla envuelve las
          líneas en lugar de estirarse de lado a lado. */}
      <p
        class="inline-flex items-center gap-2.5 rounded-full bg-rosa py-1.5 pl-1.5 pr-5 text-sm leading-snug text-ink md:text-base"
      >
        {/* El círculo no se achica ni se deforma cuando el texto envuelve en
            dos líneas, de ahí el shrink-0. */}
        <span
          class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-ink text-paper"
          aria-hidden="true"
        >
          {/* El triángulo va corrido 0,8 hacia arriba respecto del centro
              geométrico de la caja. Apoyado en su base pesa abajo, así que
              centrado por su caja se ve hundido dentro del círculo. */}
          <svg
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 2.8 2.2 19.6h19.6L12 2.8Z" />
            <path d="M12 9v4.4" />
            <path d="M12 16.7h.01" />
          </svg>
        </span>
        Solo para empresas en el rubro industrial con modelo B2B y ventas directas.
      </p>

      <h1
        class="mt-6 text-[2.7rem] font-normal leading-[1.08] tracking-tight sm:text-5xl md:text-6xl"
      >
        Reuniones con los <strong class="font-bold">decisores de tus empresas objetivo</strong> de
        manera continua
      </h1>

    </div>
  </div>
</section>
