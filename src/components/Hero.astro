---
import Cta from './Cta.astro';
import { BLOCK_H, PAGE_INSET, PAGE_RADIUS } from './HeaderShape.astro';

// Cifras estructurales del programa, tomadas de la propuesta de trabajo.
const marcas = [
  { valor: 'Día 10', detalle: 'el sistema ya está funcionando' },
  { valor: '15 a 30 días', detalle: 'para las primeras reuniones' },
];
---

<!-- El contenedor va contra el borde superior de la página. El header se apoya
     encima, por eso el contenido arranca despejando su alto. -->
<section id="contenido" style={`padding:0 ${PAGE_INSET}px`}>
  <div
    class="relative isolate overflow-hidden text-paper"
    style={`border-radius:${PAGE_RADIUS}px`}
  >
    <!-- Degradé oscuro y tres manchas que derivan por encima. -->
    <div aria-hidden="true" class="aurora pointer-events-none absolute inset-0">
      <span class="mancha mancha-a"></span>
      <span class="mancha mancha-b"></span>
      <span class="mancha mancha-c"></span>
    </div>

    <div
      class="relative mx-auto max-w-6xl px-6 pb-24 md:pb-32"
      style={`padding-top:${BLOCK_H + 72}px`}
    >
      <h1
        class="max-w-4xl text-4xl font-normal leading-[1.06] tracking-tight sm:text-5xl md:text-6xl lg:text-7xl"
      >
        Reuniones con los decisores<br class="hidden sm:block" /> de las cuentas que te importan
      </h1>

      <p class="mt-8 max-w-2xl text-lg leading-relaxed text-line md:text-xl">
        Tu equipo comercial cierra y cuida relaciones. Nosotros abrimos las conversaciones que
        todavía no existen, con las empresas que elegiste y con la persona que decide, sin depender
        de referidos ni de los clientes de siempre.
      </p>

      <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
        {/* Mismas dimensiones que el del header. */}
        <Cta variant="light" size="sm" pixel="boton_hero" />
        <span class="text-sm text-line">Reunión de 30 minutos, sin costo</span>
      </div>

      <dl class="mt-16 grid max-w-lg grid-cols-1 gap-4 sm:grid-cols-2">
        {
          marcas.map((m) => (
            <div class="rounded-[10px] border border-white/15 bg-white/5 p-6 backdrop-blur-sm">
              <dt class="text-2xl font-normal tracking-tight">{m.valor}</dt>
              <dd class="mt-2 text-sm leading-relaxed text-line">{m.detalle}</dd>
            </div>
          ))
        }
      </dl>

      <p class="mt-10 max-w-2xl text-sm leading-relaxed text-line">
        Operamos sistemas de prospección para servicios IT, fintech, tecnologías inmersivas y
        desarrollo inmobiliario, en Argentina, México, Paraguay y Colombia.
      </p>
    </div>
  </div>
</section>

<style>
  /* Fondo del hero, un degradé oscuro con tres manchas que derivan por encima.
     Solo se animan transformaciones, así el trabajo queda en la GPU y no fuerza
     recálculos de layout. */
  .aurora {
    background: linear-gradient(150deg, #3b4349 0%, #20262a 46%, #0e1113 100%);
  }

  .mancha {
    position: absolute;
    display: block;
    border-radius: 9999px;
    filter: blur(80px);
    will-change: transform;
  }

  .mancha-a {
    width: 78%;
    aspect-ratio: 1;
    top: -38%;
    left: -16%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.3) 0%, rgba(255, 255, 255, 0) 68%);
    animation: deriva-a 17s ease-in-out infinite alternate;
  }

  /* El gris de marca, acá con bastante presencia porque el fondo es oscuro. */
  .mancha-b {
    width: 74%;
    aspect-ratio: 1;
    bottom: -40%;
    right: -14%;
    background: radial-gradient(circle, rgba(91, 115, 130, 0.85) 0%, rgba(91, 115, 130, 0) 70%);
    animation: deriva-b 21s ease-in-out infinite alternate;
  }

  .mancha-c {
    width: 60%;
    aspect-ratio: 1;
    top: 16%;
    left: 34%;
    background: radial-gradient(circle, rgba(143, 163, 174, 0.45) 0%, rgba(143, 163, 174, 0) 70%);
    animation: deriva-c 26s ease-in-out infinite alternate;
  }

  @keyframes deriva-a {
    from {
      transform: translate3d(-6%, -4%, 0) scale(0.9);
    }
    to {
      transform: translate3d(26%, 22%, 0) scale(1.35);
    }
  }

  @keyframes deriva-b {
    from {
      transform: translate3d(8%, 6%, 0) scale(1.25);
    }
    to {
      transform: translate3d(-28%, -20%, 0) scale(0.92);
    }
  }

  @keyframes deriva-c {
    from {
      transform: translate3d(10%, -8%, 0) scale(0.95);
    }
    to {
      transform: translate3d(-22%, 24%, 0) scale(1.4);
    }
  }

  /* El bloque global de prefers-reduced-motion ya congela estas animaciones. */
  @media (prefers-reduced-motion: reduce) {
    .mancha {
      transform: none;
    }
  }
</style>
