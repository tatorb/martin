---
import Cta from './Cta.astro';
import { BLOCK_H, PAGE_INSET, PAGE_RADIUS } from './HeaderShape.astro';

// Cifras estructurales del programa, tomadas de la propuesta de trabajo.
const marcas = [
  { valor: 'Día 10', detalle: 'el sistema ya está funcionando' },
  { valor: '15 a 30 días', detalle: 'para las primeras reuniones' },
  { valor: 'Garantía', detalle: '15 reuniones en 90 días' },
];
---

<!-- El contenedor va contra el borde superior de la página. El header se apoya
     encima, por eso el contenido arranca despejando su alto. -->
<section id="contenido" style={`padding:0 ${PAGE_INSET}px`}>
  <div
    class="relative isolate overflow-hidden bg-mist text-ink"
    style={`border-radius:${PAGE_RADIUS}px`}
  >
    <div
      class="relative mx-auto max-w-6xl px-6 pb-24 md:pb-32"
      style={`padding-top:${BLOCK_H + 72}px`}
    >
      {/* A quién le habla la página, en la pastilla rosa de la marca. El ancho
          lo da el texto, así que en pantallas angostas la pastilla envuelve las
          líneas en lugar de estirarse de lado a lado. */}
      <p
        class="inline-flex items-center gap-2.5 rounded-full bg-rosa py-1.5 pl-1.5 pr-5 text-sm leading-relaxed text-rosa-texto md:text-base"
      >
        {/* El círculo no se achica ni se deforma cuando el texto envuelve en
            dos líneas, de ahí el shrink-0. */}
        <span
          class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-ink text-paper"
          aria-hidden="true"
        >
          {/* El triángulo va corrido 0,8 hacia arriba respecto del centro
              geométrico de la caja. Apoyado en su base pesa abajo, así que
              centrado por su caja se ve hundido dentro del círculo. */}
          <svg
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 2.8 2.2 19.6h19.6L12 2.8Z" />
            <path d="M12 9v4.4" />
            <path d="M12 16.7h.01" />
          </svg>
        </span>
        Para empresas en el rubro industrial con modelo B2B, ventas directas y consultivas.
      </p>

      <h1
        class="mt-6 max-w-4xl text-4xl font-normal leading-[1.08] tracking-tight sm:text-5xl md:text-6xl"
      >
        Reuniones con los decisores de tus empresas objetivo de manera continua
      </h1>

      <dl class="mt-12 grid max-w-3xl grid-cols-1 gap-4 sm:grid-cols-3">
        {
          marcas.map((m) => (
            <div class="rounded-[10px] border border-line bg-paper p-6">
              <dt class="text-2xl font-normal tracking-tight">{m.valor}</dt>
              <dd class="mt-2 text-sm leading-relaxed text-muted">{m.detalle}</dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
        {/* Mismas dimensiones que el del header. */}
        <Cta size="sm" pixel="boton_hero" />
        <span class="text-sm text-muted">Reunión de 30 minutos, sin costo</span>
      </div>
    </div>
  </div>
</section>
