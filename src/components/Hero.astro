---
import Cta from './Cta.astro';

// Cifras estructurales del programa, tomadas de la propuesta de trabajo.
const marcas = [
  { valor: 'Día 20', detalle: 'el sistema ya está ejecutando' },
  { valor: '2 meses', detalle: 'de piloto sobre un mercado acotado' },
  { valor: '3 canales', detalle: 'mail, LinkedIn y llamadas' },
];
---

<section id="contenido" class="bg-shell px-3 pb-3">
  <div class="relative isolate overflow-hidden rounded-[28px] bg-shell">
    <!-- Degradé de base y tres manchas que derivan muy lento por encima. -->
    <div aria-hidden="true" class="aurora pointer-events-none absolute inset-0">
      <span class="mancha mancha-a"></span>
      <span class="mancha mancha-b"></span>
      <span class="mancha mancha-c"></span>
    </div>

    <div class="relative mx-auto max-w-6xl px-6 pb-24 pt-20 md:pb-32 md:pt-28">
    <p class="eyebrow">Apertura de Cuentas</p>

    <h1
      class="mt-6 max-w-4xl text-4xl font-bold leading-[1.06] tracking-tight sm:text-5xl md:text-6xl lg:text-7xl"
    >
      Reuniones con los decisores<br class="hidden sm:block" /> de las cuentas que te importan
    </h1>

    <p class="mt-8 max-w-2xl text-lg leading-relaxed text-muted md:text-xl">
      Tu equipo comercial cierra y cuida relaciones. Nosotros abrimos las conversaciones que
      todavía no existen, con las empresas que elegiste y con la persona que decide, sin depender
      de referidos ni de los clientes de siempre.
    </p>

    <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
      <Cta />
      <span class="text-sm text-muted">Reunión de 30 minutos, sin costo</span>
    </div>

    <dl class="mt-16 grid max-w-3xl grid-cols-1 gap-px border border-line bg-line sm:grid-cols-3">
      {
        marcas.map((m) => (
          <div class="bg-paper px-6 py-7">
            <dt class="text-2xl font-bold tracking-tight">{m.valor}</dt>
            <dd class="mt-2 text-sm leading-relaxed text-muted">{m.detalle}</dd>
          </div>
        ))
      }
    </dl>

      <p class="mt-10 max-w-2xl text-sm leading-relaxed text-muted">
        Operamos sistemas de prospección para servicios IT, fintech, tecnologías inmersivas y
        desarrollo inmobiliario, en Argentina, México, Paraguay y Colombia.
      </p>
    </div>
  </div>
</section>

<style>
  /* Fondo del hero, un degradé de grises con tres manchas que derivan muy lento
     por encima. Solo se animan transformaciones, así el trabajo queda en la GPU
     y no fuerza recálculos de layout. */
  .aurora {
    background: linear-gradient(155deg, #f7f8f9 0%, #e4e7ea 48%, #d2d6da 100%);
  }

  .mancha {
    position: absolute;
    display: block;
    border-radius: 9999px;
    filter: blur(90px);
    will-change: transform;
  }

  .mancha-a {
    width: 70%;
    aspect-ratio: 1;
    top: -32%;
    left: -12%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0) 68%);
    animation: deriva-a 28s ease-in-out infinite alternate;
  }

  .mancha-b {
    width: 62%;
    aspect-ratio: 1;
    bottom: -34%;
    right: -10%;
    background: radial-gradient(circle, rgba(178, 186, 194, 0.75) 0%, rgba(178, 186, 194, 0) 70%);
    animation: deriva-b 36s ease-in-out infinite alternate;
  }

  /* Un dejo del gris de marca, apenas perceptible, para que el fondo no quede neutro del todo. */
  .mancha-c {
    width: 52%;
    aspect-ratio: 1;
    top: 22%;
    left: 38%;
    background: radial-gradient(circle, rgba(91, 115, 130, 0.16) 0%, rgba(91, 115, 130, 0) 70%);
    animation: deriva-c 44s ease-in-out infinite alternate;
  }

  @keyframes deriva-a {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      transform: translate3d(14%, 10%, 0) scale(1.14);
    }
  }

  @keyframes deriva-b {
    from {
      transform: translate3d(0, 0, 0) scale(1.08);
    }
    to {
      transform: translate3d(-16%, -12%, 0) scale(1);
    }
  }

  @keyframes deriva-c {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      transform: translate3d(-12%, 14%, 0) scale(1.2);
    }
  }

  /* El bloque global de prefers-reduced-motion ya congela estas animaciones,
     pero dejamos las manchas quietas en una posición intermedia para que el
     fondo siga leyéndose bien sin movimiento. */
  @media (prefers-reduced-motion: reduce) {
    .mancha {
      transform: none;
    }
  }
</style>
